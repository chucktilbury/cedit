#!/usr/bin/env bash

set -o errexit -o nounset -o pipefail

diagnostic() {
    printf 'cedit: error[%s]: %s\n' "$1" "$2" >&2
}

if [[ -n "${_PROJECT_NAME:-}" ]]; then
    diagnostic CEDIT0002 \
        "a project shell is already active ($_PROJECT_NAME); exit it before starting another"
    exit 1
fi

if (( $# > 1 )); then
    diagnostic CEDIT0001 "usage: $0 [debug|release|profile]"
    exit 2
fi

build_type=""
cmake_build_type=""
if (( $# == 1 )); then
    build_type="$1"
    case "$build_type" in
        debug)
            cmake_build_type=Debug
            ;;
        release)
            cmake_build_type=Release
            ;;
        profile)
            cmake_build_type=RelWithDebInfo
            ;;
        *)
            diagnostic CEDIT0001 \
                "unknown build type '$build_type'; usage: $0 [debug|release|profile]"
            exit 2
            ;;
    esac
fi

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
build_dir="$project_root/build"

if [[ -z "${CWHIP_SDK:-}" ]]; then
    config_home="${XDG_CONFIG_HOME:-}"
    if [[ -z "$config_home" && -n "${HOME:-}" ]]; then
        config_home="$HOME/.config"
    fi
    if [[ -n "$config_home" && "$config_home" != /* ]]; then
        diagnostic CEDIT2001 \
            "cannot discover sdk_prefix: config home '$config_home' is not absolute"
        exit 1
    fi
    cwhip_config="$config_home/cwhip"
    if [[ -n "$config_home" && ( -e "$cwhip_config/sdk.toml" || -L "$cwhip_config/sdk.toml" ||
        -e "$cwhip_config/settings.toml" || -L "$cwhip_config/settings.toml" ) ]]; then
        if ! sdk_prefix="$(python3 "$project_root/scripts/sdk-prefix.py" "$cwhip_config")"; then
            diagnostic CEDIT2001 \
                "SDK settings discovery failed; project shell was not started"
            exit 1
        fi
        if [[ -n "$sdk_prefix" ]]; then
            export CWHIP_SDK="$sdk_prefix"
        fi
    fi
fi

export _PROJECT_LOC="$project_root"
export _PROJECT_NAME="$(basename -- "$project_root")"

cmake_args=(-S "$project_root" -B "$build_dir")
if [[ -n "$cmake_build_type" ]]; then
    cmake_args+=("-DCMAKE_BUILD_TYPE=$cmake_build_type")
fi
if ! cmake "${cmake_args[@]}"; then
    diagnostic CEDIT3001 \
        "CMake configuration failed; project shell was not started"
    exit 1
fi

cmake_build_type="$(sed -n 's/^CMAKE_BUILD_TYPE:[^=]*=//p' "$build_dir/CMakeCache.txt")"
case "$cmake_build_type" in
    Debug) build_type=debug ;;
    Release) build_type=release ;;
    RelWithDebInfo) build_type=profile ;;
    "") build_type=default ;;
    *) build_type="${cmake_build_type,,}" ;;
esac
export _BUILD_TYPE="$build_type"
export CWHIP_BUILD_TYPE="$cmake_build_type"

bash --rcfile "$project_root/.project_env" -i
